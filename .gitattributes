# Normalise line endings in the repository
* text=auto

# Shell script must keep Unix line endings to run on macOS/Linux/Git Bash
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep Windows line endings
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch
*.ttf binary
*.jar binary
*.png binary
*.jpg binary
